  },
  "class": {
    "prefix": "class",
    "body": [
      "class ${1:Name} {",
      "public:",
      "    $1() = default;",
      "    $0",
      "private:",
      "};"
    ],
    "description": "class"
  },
  "struct": {
    "prefix": "struct",
    "body": [
      "struct ${1:Name} {",
      "    $0",
      "};"
    ],
    "description": "struct"
  },
  "enumc": {
    "prefix": "enumc",
    "body": [
