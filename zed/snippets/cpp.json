{
  "main": {
    "prefix": "main",
    "body": [
      "int main(int argc, char *argv[]) {",
      "    $0",
      "    return 0;",
      "}"
    ],
    "description": "main()"
  },
  "inc": {
    "prefix": "inc",
    "body": [
      "#include <${1:stdio.h}>$0"
    ],
    "description": "#include <>"
  },
  "incl": {
    "prefix": "incl",
    "body": [
      "#include \"${1:header.h}\"$0"
    ],
    "description": "#include \"\""
  },
  "for": {
    "prefix": "for",
    "body": [
      "for (int ${1:i} = 0; $1 < ${2:n}; $1++) {",
      "    $0",
      "}"
    ],
    "description": "for loop"
  },
  "if": {
    "prefix": "if",
    "body": [
      "if (${1:cond}) {",
      "    $0",
      "}"
    ],
    "description": "if"
  },
  "ife": {
    "prefix": "ife",
    "body": [
      "if (${1:cond}) {",
      "    $2",
      "} else {",
      "    $0",
      "}"
    ],
    "description": "if/else"
  },
  "while": {
    "prefix": "while",
    "body": [
      "while (${1:cond}) {",
      "    $0",
      "}"
    ],
    "description": "while loop"
  },
  "switch": {
    "prefix": "switch",
    "body": [
      "switch (${1:x}) {",
      "case ${2:0}:",
      "    $0",
      "    break;",
      "default:",
      "    break;",
      "}"
    ],
    "description": "switch"
  },
  "guard": {
    "prefix": "guard",
    "body": [
      "#ifndef ${1:HEADER_H}",
      "#define $1",
      "",
      "$0",
      "",
      "#endif /* $1 */"
    ],
    "description": "include guard"
  },
  "fn": {
    "prefix": "fn",
    "body": [
      "${1:void} ${2:name}(${3:void}) {",
      "    $0",
      "}"
    ],
    "description": "function"
  },
  "def": {
    "prefix": "def",
    "body": [
      "#define ${1:NAME} ${2:value}$0"
    ],
    "description": "#define"
  },
  "assert": {
    "prefix": "assert",
    "body": [
      "assert(${1:cond});$0"
    ],
    "description": "assert()"
  },
  "exit": {
    "prefix": "exit",
    "body": [
      "exit(${1:EXIT_FAILURE});$0"
    ],
    "description": "exit()"
  },
  "cout": {
    "prefix": "cout",
    "body": [
      "std::cout << ${1:value} << \"\\n\";$0"
    ],
    "description": "std::cout"
  },
  "cerr": {
    "prefix": "cerr",
    "body": [
      "std::cerr << ${1:value} << \"\\n\";$0"
    ],
    "description": "std::cerr"
  },
  "cin": {
    "prefix": "cin",
    "body": [
      "std::cin >> ${1:var};$0"
    ],
    "description": "std::cin"
  },
  "println": {
    "prefix": "println",
    "body": [
      "std::println(\"${1:{}}\"${2:, ${3:args}});$0"
    ],
    "description": "std::println (C++23)"
  },
  "format": {
    "prefix": "format",
    "body": [
      "std::format(\"${1:{}}\"${2:, ${3:args}})$0"
