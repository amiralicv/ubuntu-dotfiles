{
  "printf": {
    "prefix": "printf",
    "body": [
      "printf(\"${1:%s}\\n\"${2:, ${3:args}});$0"
    ],
    "description": "printf() (stdio.h)"
  },
  "scanf": {
    "prefix": "scanf",
    "body": [
      "scanf(\"${1:%d}\", &${2:var});$0"
    ],
    "description": "scanf() (stdio.h)"
  },
  "fprintf": {
    "prefix": "fprintf",
    "body": [
      "fprintf(${1:stderr}, \"${2:%s}\\n\"${3:, ${4:args}});$0"
    ],
    "description": "fprintf() (stdio.h)"
  },
  "snprintf": {
    "prefix": "snprintf",
    "body": [
      "snprintf(${1:buf}, ${2:sizeof(buf)}, \"${3:%s}\"${4:, ${5:args}});$0"
    ],
    "description": "snprintf() (stdio.h)"
  },
  "fopen": {
    "prefix": "fopen",
    "body": [
      "FILE *${1:f} = fopen(${2:path}, \"${3:r}\");",
      "if (!$1) {",
      "    perror(\"fopen\");",
      "    return ${4:1};",
      "}$0"
    ],
    "description": "fopen with check"
  },
  "malloc": {
    "prefix": "malloc",
    "body": [
