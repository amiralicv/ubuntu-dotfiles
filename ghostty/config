# Font
font-family = "JetBrainsMono Nerd Font"
font-size = 11

# Window (Omarchy)
window-padding-x = 5
window-padding-y = 5
window-theme = ghostty
confirm-close-surface = false
resize-overlay = never
gtk-single-instance = true
gtk-titlebar-style = tabs

# Cursor
cursor-style = block
cursor-style-blink = true
adjust-cursor-thickness = 3
shell-integration-features = no-cursor

# Performance
async-backend = auto

# Keys
keybind = shift+insert=paste_from_clipboard
keybind = control+insert=copy_to_clipboard

# Gruvbox (Omarchy theme)
background = #282828
foreground = #d4be98
cursor-color = #d4be98
cursor-text = #282828
selection-background = #504945
selection-foreground = #d4be98
palette = 0=#3c3836
palette = 1=#ea6962
palette = 2=#a9b665
palette = 3=#d8a657
palette = 4=#7daea3
palette = 5=#d3869b
palette = 6=#89b482
palette = 7=#d4be98
palette = 8=#7c6f64
palette = 9=#ea6962
palette = 10=#a9b665
palette = 11=#d8a657
palette = 12=#7daea3
palette = 13=#d3869b
palette = 14=#89b482
palette = 15=#d4be98

# Initial window size (in character cells)
window-width = 140
window-height = 40

